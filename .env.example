# Example only. Keep real values outside version control.
GEMINI_API_KEY=""
# Optional. Overrides the analysis model (default: gemini-3.8-flash). Changing it re-analyses
# every collected item once because the model is part of the AI cache key.
GEMINI_ANALYSIS_MODEL=""
ENABLE_INTERNAL_SCHEDULER="false"
POLL_JOB_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_MIN_IMPORTANCE="4"
FIRESTORE_DATABASE_ID=""
DATA_GO_KR_API_KEY=""
APP_URL=""

# Optional tuning (defaults shown)
# PUBLIC_CACHE_TTL_MS="60000"       # cache for public read APIs
# POLL_LOCK_TTL_MS="900000"         # max length of one collection cycle lock (15 min)
# AI_MAX_ITEMS_PER_CYCLE="80"       # Gemini analyses per cycle; extra items roll over

# Development only: show production data read-only by proxying public GET APIs.
# Never active when NODE_ENV=production.
# PREVIEW_MODE="true"
# PREVIEW_UPSTREAM_ORIGIN="https://api.dsoom.com"
